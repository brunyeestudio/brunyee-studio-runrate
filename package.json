  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test:unit": "playwright install && vitest",
    "test": "npm run test:unit -- --run && npm run test:e2e",
    "test:appium": "wdio run ./tests/appium/wdio.conf.ts",
    "test:appium:android": "wdio run ./tests/appium/wdio.conf.ts --suite android",
    "test:appium:ios": "wdio run ./tests/appium/wdio.conf.ts --suite ios",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
